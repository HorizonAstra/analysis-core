#!/usr/bin/env bash
# mo — the one entry point for Multiomics. Everything you can start, you start from here:
#
#   ./mo setup      install and configure, once
#   ./mo web        the browser app
#   ./mo cli        the terminal chat
#   ./mo desktop    register the tools with Claude Desktop
#   ./mo docker     the container build
#   ./mo status     what is installed and configured right now
#   ./mo capabilities  which analysis tools are actually available, and why not
#
# One command with subcommands, instead of a handful of scripts whose names you have to
# remember. Run `./mo` on its own for the list.

set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

# The client is one partition of a larger tree, and some of what setup installs
# belongs to the others: a domain owns the environments its analyses run in, and
# infrastructure owns the data layer. Named once here, because a client reaching
# into a sibling partition by counting `..` is how a move turns into a silent
# breakage rather than one edit.
TREE="$(cd "$ROOT/.." && pwd)"

PY=".venv/bin/python3"
BOLD=$'\033[1m'; DIM=$'\033[2m'; OFF=$'\033[0m'

die() { echo "error: $*" >&2; exit 1; }

usage() {
  cat <<EOF

${BOLD}Multiomics${OFF} ${DIM}analysis toolkit${OFF}

  ${BOLD}./mo setup${OFF}      install dependencies, create folders, warm the data cache
  ${BOLD}./mo web${OFF}        run the browser app        ${DIM}(sets up first if needed)${OFF}
  ${BOLD}./mo cli${OFF}        run the terminal chat
  ${BOLD}./mo desktop${OFF}    register the tools with Claude Desktop
  ${BOLD}./mo docker${OFF}     build and run the container
  ${BOLD}./mo status${OFF}     show what is installed and configured
  ${BOLD}./mo capabilities${OFF}  which analysis tools are actually available, and why not
  ${BOLD}./mo help${OFF}       this list

${DIM}Options are environment variables, in front of the command:
  PORT=8080 ./mo web            serve on another port
  DEV_RELOAD=1 ./mo web         restart on file edits
  LLM_PROVIDER=google ./mo cli  use Gemini instead of Claude${OFF}

EOF
}

# ── shared checks ───────────────────────────────────────────────────────────
have_venv() { [ -x "$PY" ]; }

need_venv() {
  have_venv || die "not set up yet. Run: ./setup.sh from the repository root."
}

# .env holds the keys and the session secret; set once, not per run. Anything already in
# the real environment wins over the file, so `LLM_PROVIDER=google ./mo cli` does what it
# says. That is also how config.py reads it on the Python side, and the two must agree.
load_env() {
  [ -f .env ] || return 0
  local already; already="$(export -p)"      # snapshot before the file can overwrite
  set -a; . ./.env; set +a
  # put the caller's own values back. `export -p` emits `declare -x`, and plain `declare`
  # inside a function makes a local that dies on return, so rewrite it to `export`.
  eval "${already//declare -x /export }" 2>/dev/null || true
}

# Checks the key for whichever provider is selected. $1 is the provider default to assume
# when nothing sets one (the web app serves Google; the CLI is Claude-first).
need_key() {
  local provider="${LLM_PROVIDER:-$1}"
  case "$provider" in
    google|gemini)
      [ -n "${GEMINI_API_KEY:-}${GOOGLE_API_KEY:-}" ] || die \
        "LLM_PROVIDER=$provider but no GEMINI_API_KEY or GOOGLE_API_KEY found. Put one in .env"
      ;;
    *)
      [ -n "${ANTHROPIC_API_KEY:-}" ] || die \
        "ANTHROPIC_API_KEY is not set. Put it in .env, or use Google: LLM_PROVIDER=google"
      ;;
  esac
  echo "$provider"
}

# Where study data actually is. DATA_ROOT is what every other part of the product
# reads, so this reads the same thing: `data/` beside the client is only the
# default, and a deployment that points elsewhere was being told it had no
# studies while the app was busy analysing them.
data_root() { echo "${DATA_ROOT:-$ROOT/data}"; }
studies_line() { ls "$(data_root)" 2>/dev/null | grep -v README | tr '\n' ' ' || echo "(none yet)"; }

# ── commands ────────────────────────────────────────────────────────────────
cmd_setup() {
  # Installing this tree is not a client's job, and doing it here made it two
  # jobs that disagreed: this built one domain's environments by name while
  # ./setup.sh builds whatever the catalog declares, so a domain added later was
  # installed by one and silently skipped by the other. One installer, named
  # once, the same one a person cloning the repository is told to run.
  echo
  echo "${BOLD}Installing is done from the repository root, not from a client.${OFF}"
  echo
  echo "    cd $TREE && ./setup.sh"
  echo
  echo "${DIM}It builds the client environment and every environment the catalog"
  echo "declares, and it is safe to re-run.${OFF}"
  echo
  return 1
}

cmd_capabilities() {
  have_venv || die "not set up yet. Run: ./setup.sh from the repository root."
  "$PY" "$ROOT/capabilities.py" "$@"
}

cmd_web() {
  have_venv || { cmd_setup; exit 1; }
  "$PY" -c "import fastapi, uvicorn" 2>/dev/null \
    || die "web dependencies missing. Run: ./mo setup"
  [ -f .env ] || die "no .env found. Copy it first:  cp .env.example .env"
  load_env
  local provider; provider="$(need_key google)"
  local port="${PORT:-8000}"
  echo
  echo "${BOLD}Multiomics${OFF}  ${DIM}web${OFF}"
  echo "  Provider: $provider"
  echo "  Open:     http://127.0.0.1:$port"
  echo "  Studies:  $(studies_line)"
  echo
  exec "$PY" webapp/server.py
}

cmd_cli() {
  need_venv
  load_env
  local provider; provider="$(need_key anthropic)"
  local model
  case "$provider" in
    google|gemini) model="${GEMINI_MODEL:-${GOOGLE_MODEL:-gemini-2.5-flash}}" ;;
    *)             model="${ANTHROPIC_MODEL:-claude-sonnet-5}" ;;
  esac
  echo
  echo "${BOLD}Multiomics${OFF}  ${DIM}cli${OFF}"
  echo "  Provider: $provider    Model: $model"
  echo "  Studies:  $(studies_line)"
  echo
  exec "$PY" chat_client.py
}

cmd_desktop() {
  need_venv
  local dir="$HOME/Library/Application Support/Claude"
  local cfg="$dir/claude_desktop_config.json"
  local server="$ROOT/mcp-server/mcp_server.py"

  [ -d "$HOME/Library/Application Support" ] || die \
    "this writes the macOS Claude Desktop config. On Windows or Linux, copy
       claude_desktop_config.example.json into your own config and fix the paths."

  mkdir -p "$dir"
  if [ -f "$cfg" ]; then
    cp "$cfg" "$cfg.backup_$(date +%Y%m%d_%H%M%S)"
    echo "Backed up the existing config."
  fi

  # MERGE, never overwrite. That file is not ours: it also holds Claude Desktop's own
  # preferences and any other MCP server the user has wired up, and clobbering it to add one
  # entry costs them all of that. Only mcpServers["analysis-toolkit"] is touched.
  "$ROOT/$PY" - "$cfg" "$ROOT/$PY" "$server" <<'PY'
import json, os, sys
cfg, py, server = sys.argv[1], sys.argv[2], sys.argv[3]

data, note = {}, ""
if os.path.isfile(cfg):
    try:
        with open(cfg) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            data, note = {}, "the existing config was not a JSON object; started fresh"
    except (ValueError, OSError) as e:
        data, note = {}, f"the existing config could not be parsed ({e}); started fresh"

servers = data.setdefault("mcpServers", {})
if not isinstance(servers, dict):
    servers, note = {}, "mcpServers was not an object; replaced it"
    data["mcpServers"] = servers

servers["analysis-toolkit"] = {"command": py, "args": [server]}
with open(cfg, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")

others = sorted(k for k in servers if k != "analysis-toolkit")
if note:
    print(f"  ! {note} (the backup has the original)")
print(f"  kept {len(data) - 1} other top-level settings"
      + (f", and MCP server(s): {', '.join(others)}" if others else ""))
PY
  echo "Written: $cfg"
  echo
  echo "Now fully quit Claude Desktop (Cmd+Q) and reopen it. The tools appear in its panel."
  echo
}

cmd_docker() {
  # A local convenience. The deployable artifact is the image itself (see Dockerfile), which
  # is a plain OCI image: it also runs under Podman or Kubernetes, and converts to
  # Apptainer/Singularity for an HPC with no Docker. Compose is just one way to hand it a
  # port, secrets, a read-only data mount and a writable /state.
  command -v docker >/dev/null || die "docker is not installed"
  [ -f .env ] || die "no .env found. Copy it first:  cp .env.example .env"
  exec docker compose up --build
}

cmd_status() {
  echo
  echo "${BOLD}Multiomics${OFF}  ${DIM}$ROOT${OFF}"
  echo
  if have_venv; then
    echo "  setup      ready ${DIM}($("$PY" --version 2>&1))${OFF}"
  else
    echo "  setup      not done ${DIM}(run: ./setup.sh from the repository root)${OFF}"
  fi
  if [ -f .env ]; then
    load_env
    local provider="${LLM_PROVIDER:-google}" key="missing"
    case "$provider" in
      google|gemini) [ -n "${GEMINI_API_KEY:-}${GOOGLE_API_KEY:-}" ] && key="present" ;;
      *)             [ -n "${ANTHROPIC_API_KEY:-}" ] && key="present" ;;
    esac
    echo "  .env       found ${DIM}(provider: $provider, key: $key)${OFF}"
    [ "$key" = "missing" ] && echo "             ${DIM}add the key for '$provider' to .env${OFF}"
  else
    echo "  .env       missing ${DIM}(cp .env.example .env)${OFF}"
  fi
  local n; n="$(ls "$(data_root)" 2>/dev/null | grep -cv README || true)"
  echo "  studies    ${n:-0} in $(data_root)  ${DIM}$(studies_line)${OFF}"
  if [ -f "$HOME/Library/Application Support/Claude/claude_desktop_config.json" ] \
     && grep -q "analysis-toolkit" "$HOME/Library/Application Support/Claude/claude_desktop_config.json" 2>/dev/null; then
    echo "  desktop    registered"
  else
    echo "  desktop    not registered ${DIM}(run: ./mo desktop)${OFF}"
  fi
  echo
}

case "${1:-help}" in
  setup)            shift; cmd_setup "$@" ;;
  web|start|app)    shift; cmd_web "$@" ;;
  cli|chat)         shift; cmd_cli "$@" ;;
  desktop)          shift; cmd_desktop "$@" ;;
  docker)           shift; cmd_docker "$@" ;;
  status)           shift; cmd_status "$@" ;;
  capabilities|caps) shift; cmd_capabilities "$@" ;;
  help|-h|--help)   usage ;;
  *) echo "unknown command: $1" >&2; usage; exit 1 ;;
esac
