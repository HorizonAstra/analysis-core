# Copy to .env and fill in. .env is gitignored and is NEVER copied into the Docker image
# or sent to the browser — the LLM key stays server-side. Set it once; you won't be asked
# for it per run.
#
# IMPORTANT: never put a real key in THIS example file. Example files are committed
# (not gitignored), so a key here would leak into git history. Real values go in .env.

# ── LLM (the dev picks the single model the product serves) ──────────────────
# anthropic, google
LLM_PROVIDER=anthropic
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=your-google-ai-studio-key-here
# Both backends' settings live here at once; only the selected provider's are read.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium

# Optional Claude knobs; uncomment to override the defaults shown.
# Effort levels: low | medium | high | xhigh | max
# Set any of these three to 0 to switch that request feature off (all default on):
#ANTHROPIC_THINKING=1
#ANTHROPIC_CACHE=1
#ANTHROPIC_COMPACT=1
# Request timeout in seconds for a model call (default 1200). Tool runtime is NOT
# covered by this: tools run in our own process, between model calls, untimed.
#ANTHROPIC_TIMEOUT=1200

# ── loop limits (provider-independent) ───────────────────────────────────────
# Max model->tool->model round trips in one user turn (default 25)
#LLM_MAX_STEPS=25
# Output budget per response; thinking shares it (default 32000)
#LLM_MAX_TOKENS=32000
# Chats keeping a live model conversation in memory (default 50). Only a memory bound:
# each chat's history is on disk, so an evicted chat rehydrates on its next message.
#LLM_MAX_LIVE_CHATS=50
# Seconds between pressing send and anything actually happening (default 1.5). Stopping
# inside it costs nothing: no request was made and the message was not saved, so the text
# goes back to the composer. The tradeoff is that every turn starts this much later.
# Set to 0 to remove the pause (stopping then always costs whatever was already spent).
#LLM_SEND_GRACE=1.5

# ── where the data and the outputs live ──────────────────────────────────────
# Both are optional. Unset, they resolve to the repo's own data/ and outputs/ folders,
# which is what a fresh checkout needs and why the defaults are not written in here.
# Set them to move either tree onto a mounted volume (a Box or object-store mount, a
# shared drive, a path outside the container).
#
# An absolute path is safest: the tool server is a separate process and does not share
# the web app's working directory, so a relative path can mean two different places.
# The web app resolves DATA_ROOT to an absolute path and passes that down, so relative
# still works there, but there is no reason to rely on it.
#
# A DATA_ROOT that is set but does not exist (a volume that failed to mount, a path from
# another machine, a typo) falls back to the repo-local data/ folder and says so on
# stderr, rather than reporting that this deployment has no studies.
#DATA_ROOT=/mnt/studies
#OUTPUTS_ROOT=/mnt/outputs

# ── sessions ─────────────────────────────────────────────────────────────────
# A long random string. Sessions survive restarts only if this is set and stable.
# Generate one with:  python3 -c "import secrets;print(secrets.token_hex(32))"
# JWE_SECRET is accepted as an alias (lets you share the same JWT secret as symbiote).
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 in production (HTTPS): marks the session cookie Secure.
COOKIE_SECURE=0

# ── the interactive spatial viewer ───────────────────────────────────────────
# SpatialView is not distributed with this repository. Its licence is a custom
# academic EULA: the person who obtains it may use it for their own academic,
# non-commercial research, and may not give a third party access to it or run it
# "on a timeshare or service bureau basis".
#
# That line falls between two things this variable can mean, so be deliberate:
#
#   one person, their own machine, their own copy, their own data  ->  fine.
#     Set this and the viewer button opens their own bundles.
#
#   a deployment serving several signed-in people  ->  not fine.
#     Serving the viewer to other accounts is the case the licence names.
#     Leave it unset there. The bundle is still produced and downloadable, and
#     each person runs their own copy of the viewer over it.
#
# Point it at a directory holding the viewer's index.html and its static files.
# Unset, the viewer route mounts nothing and says why.
#SPATIALVIEW_ROOT=/path/to/spatialview
