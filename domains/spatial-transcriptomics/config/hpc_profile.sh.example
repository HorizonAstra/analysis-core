#!/bin/bash
# =============================================================================
# config/hpc_profile.sh  —  HPC Cluster Profile
# =============================================================================
#
# Provides cluster-specific module names and a thin loading interface that
# scripts source to invoke the correct `module load` commands on whichever HPC
# the pipeline is running on.
#
# SETUP
# -----
# 1. Copy this file:
#       cp config/hpc_profile.sh.example config/hpc_profile.sh
# 2. (Optional) Edit config/hpc_profile.sh to override auto-detected defaults.
#    Key variable to review per cluster:
#      BUILD_SCRATCH_DIR — directory used for container sandbox builds.
#        Leave empty on clusters where containers/ is on an exec-safe filesystem.
#        Set to a local scratch path on GPFS/noexec clusters (e.g. Randi).
# 3. The live copy (config/hpc_profile.sh) is gitignored; this .example file
#    is the committed canonical template.
#
# AUTO-DETECTION
# --------------
# Cluster is detected by matching the short hostname against known patterns:
#   midway*, rcc*   → midway3  (University of Chicago RCC)
#   randi*, rand*   → randi    (collaborator HPC)
#   (anything else) → local    (workstation / no module system)
#
# OVERRIDE
# --------
# Set HPC_PROFILE before sourcing to skip auto-detection:
#   export HPC_PROFILE=randi
#   source config/hpc_profile.sh
#
# ADDING A NEW CLUSTER
# --------------------
# 1. Add a hostname pattern in _hpc_detect_profile() below.
# 2. Add a matching case block with the correct module names.
# =============================================================================

# ── Auto-detect (skipped if HPC_PROFILE is already exported) ─────────────────

_hpc_detect_profile() {
    local h
    h=$(hostname --short 2>/dev/null || hostname)
    case "$h" in
        *midway*|*rcc*)  echo "midway3" ;;
        *randi*|*rand*|cri22*) echo "randi" ;;
        *)               echo "local"   ;;
    esac
}

# Use existing HPC_PROFILE if set, otherwise auto-detect
: "${HPC_PROFILE:=$(_hpc_detect_profile)}"
export HPC_PROFILE

# ── Per-cluster module names ──────────────────────────────────────────────────

case "$HPC_PROFILE" in

    midway3)
        # University of Chicago RCC — Midway3
        export MODULE_SINGULARITY_PREREQS=""
        export MODULE_SINGULARITY="singularity"
        export MODULE_JULIA="julia/1.9.0"
        export MODULE_R="R/4.4.1"
        export MODULE_R_PREREQS=""                # no gcc prereq needed on Midway3
        export MODULE_PYTHON="python/anaconda-2022.05"
        export MODULE_GCC="gcc/10.2.0"         # must match the GCC used to build MODULE_R
        export MODULE_JULIA_PREREQS=""        # no prerequisites needed
        # containers/ lives on /project (exec-safe); no scratch dir needed for builds
        export BUILD_SCRATCH_DIR=""
        ;;

    randi)
        # Collaborator HPC — hierarchical module environment
        # gcc must be loaded before julia (ISSUE-6)
        # go/1.24.6 must be loaded before singularity/4.3.6
        export MODULE_SINGULARITY_PREREQS="go/1.24.6"
        export MODULE_SINGULARITY="singularity/4.3.6"
        export MODULE_JULIA="julia/1.9.0"
        export MODULE_R="R/4.4.1"
        export MODULE_R_PREREQS="gcc/12.1.0"  # R/4.4.1 requires gcc/12.1.0 on Randi
        export HPC_R_LIBS="/gpfs/data/garassino-lab/Neomemory/R_libs/4.4.1"  # shared R packages
        export MODULE_PYTHON="python/anaconda-2022.05"
        export MODULE_GCC="gcc/12.1.0"        # gcc/12.1.0 required by R/4.4.1 on Randi
        export MODULE_JULIA_PREREQS="gcc/12.1.0"  # load gcc before julia
        # containers/ is on GPFS (noexec); builds must use a local scratch directory
        export BUILD_SCRATCH_DIR="/scratch/${USER}/tumorspace_build"
        # /tmp is noexec on Randi; redirect Singularity temp files to scratch
        export SINGULARITY_TMPDIR="${BUILD_SCRATCH_DIR}/tmp"
        export TMPDIR="${BUILD_SCRATCH_DIR}/tmp"
        # LD_PRELOAD for native R on Randi — not needed in container mode
        export HPC_LD_PRELOAD_R=""
        ;;

    local)
        # Local workstation — no module system; tools expected in PATH
        export MODULE_SINGULARITY_PREREQS=""
        export MODULE_SINGULARITY=""
        export MODULE_JULIA=""
        export MODULE_R=""
        export MODULE_PYTHON=""
        export MODULE_GCC=""                   # no module needed
        export MODULE_JULIA_PREREQS=""
        export BUILD_SCRATCH_DIR=""           # no HPC filesystem constraints locally
        ;;

    *)
        echo "[hpc_profile] WARNING: Unknown HPC_PROFILE='${HPC_PROFILE}'. Using midway3 defaults." >&2
        export MODULE_SINGULARITY="singularity"
        export MODULE_JULIA="julia/1.9.0"
        export MODULE_R="R/4.4.1"
        export MODULE_R_PREREQS=""
        export MODULE_PYTHON="python/anaconda-2022.05"
        export MODULE_GCC="gcc/10.2.0"
        export MODULE_JULIA_PREREQS=""
        export BUILD_SCRATCH_DIR=""
        ;;

esac

# ── Pre-expanded module load commands (for embedding inside heredocs) ─────────
#
# These variables expand to the complete shell statement(s) needed to load each
# tool.  Use them inside unquoted << EOF heredocs when generating SBATCH scripts:
#
#   cat >> "$SBATCH_SCRIPT" << EOF
#   ${HPC_LOAD_SINGULARITY}
#   singularity exec ...
#   EOF
#
# On Midway3:  HPC_LOAD_JULIA="module load julia/1.9.0"
# On Randi:    HPC_LOAD_JULIA="module load gcc && module load julia/1.9.0"
# Locally:     HPC_LOAD_JULIA=""  (no-op)

if [[ -n "${MODULE_JULIA_PREREQS}" ]]; then
    prereq_cmds=""
    for _p in ${MODULE_JULIA_PREREQS}; do
        prereq_cmds="${prereq_cmds}module load ${_p}"$'\n'
    done
    export HPC_LOAD_JULIA="${prereq_cmds}module load ${MODULE_JULIA}"
    unset prereq_cmds _p
else
    export HPC_LOAD_JULIA="${MODULE_JULIA:+module load ${MODULE_JULIA}}"
fi

if [[ -n "${MODULE_SINGULARITY_PREREQS:-}" ]]; then
    sing_prereq_cmds=""
    for _p in ${MODULE_SINGULARITY_PREREQS}; do
        sing_prereq_cmds="${sing_prereq_cmds}module load ${_p}"$'\n'
    done
    export HPC_LOAD_SINGULARITY="${sing_prereq_cmds}module load ${MODULE_SINGULARITY}"
    unset sing_prereq_cmds _p
else
    export HPC_LOAD_SINGULARITY="${MODULE_SINGULARITY:+module load ${MODULE_SINGULARITY}}"
fi
if [[ -n "${MODULE_R_PREREQS:-}" ]]; then
    r_prereq_cmds=""
    for _p in ${MODULE_R_PREREQS}; do
        r_prereq_cmds="${r_prereq_cmds}module load ${_p}"$'\n'
    done
    export HPC_LOAD_R="${r_prereq_cmds}module load ${MODULE_R}"
    unset r_prereq_cmds _p
else
    export HPC_LOAD_R="${MODULE_R:+module load ${MODULE_R}}"
fi
# Prepend shared R library path when set (e.g. Randi where system R lacks packages)
if [[ -n "${HPC_R_LIBS:-}" ]]; then
    export HPC_LOAD_R="export R_LIBS=\"${HPC_R_LIBS}\${R_LIBS:+:}\${R_LIBS:-}\""$'\n'"${HPC_LOAD_R}"
fi
export HPC_LOAD_PYTHON="${MODULE_PYTHON:+module load ${MODULE_PYTHON}}"
export HPC_LOAD_GCC="${MODULE_GCC:+module load ${MODULE_GCC}}"

# ── Helper functions ──────────────────────────────────────────────────────────
#
# hpc_module_load VAR_NAME
#   Loads the module whose name is stored in the variable VAR_NAME.
#   Silently skips when the variable is empty (local/no-module environments).
#
#   Usage:  hpc_module_load MODULE_SINGULARITY
#
hpc_module_load() {
    local module_name="${!1}"
    [[ -z "${module_name}" ]] && return 0
    if command -v module &>/dev/null; then
        module load "${module_name}" 2>/dev/null || {
            echo "[hpc_profile] WARNING: 'module load ${module_name}' failed (continuing)" >&2
        }
    fi
}

# hpc_load_julia
#   Loads all Julia prerequisites then Julia itself.
#   On Randi this loads gcc first, then julia/1.9.0.
#   On Midway3 it loads julia/1.9.0 directly.
#   Locally this is a no-op.
#
hpc_load_julia() {
    if [[ -n "${MODULE_JULIA_PREREQS}" ]]; then
        for _prereq in ${MODULE_JULIA_PREREQS}; do
            if command -v module &>/dev/null; then
                module load "${_prereq}" 2>/dev/null || \
                    echo "[hpc_profile] WARNING: 'module load ${_prereq}' failed" >&2
            fi
        done
        unset _prereq
    fi
    hpc_module_load MODULE_JULIA
}

# hpc_load_singularity
#   Loads all Singularity prerequisites then Singularity itself.
#   On Randi this loads go/1.24.6 first, then singularity/4.3.6.
#   On Midway3 it loads singularity directly. Locally this is a no-op.
#
hpc_load_singularity() {
    if [[ -n "${MODULE_SINGULARITY_PREREQS:-}" ]]; then
        for _prereq in ${MODULE_SINGULARITY_PREREQS}; do
            if command -v module &>/dev/null; then
                module load "${_prereq}" 2>/dev/null || \
                    echo "[hpc_profile] WARNING: 'module load ${_prereq}' failed" >&2
            fi
        done
        unset _prereq
    fi
    hpc_module_load MODULE_SINGULARITY
}

# hpc_singularity_tmpdir [subdir]
#   Returns an exec-safe path for SINGULARITY_TMPDIR (where singularity extracts
#   a SIF at runtime).  On Randi (GPFS/noexec), uses BUILD_SCRATCH_DIR.
#   On Midway3 and local environments, uses SLURM-provided $TMPDIR or /tmp.
#   The directory is created if it does not exist.
#
#   Usage:  export SINGULARITY_TMPDIR="$(hpc_singularity_tmpdir)"
#
hpc_singularity_tmpdir() {
    local _subdir="${1:-singularity_tmp}"
    local _dir
    if [ -n "${BUILD_SCRATCH_DIR:-}" ]; then
        _dir="${BUILD_SCRATCH_DIR}/${_subdir}"
    else
        _dir="${TMPDIR:-/tmp}"
    fi
    mkdir -p "$_dir" 2>/dev/null || true
    echo "$_dir"
}
